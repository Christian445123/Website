# Mindest-Level für Discord-Benachrichtigungen:
#   debug    = ALLE Events inkl. PHP Notices, Deprecated, Strict (sehr viel Traffic!)
#   info     = Logins, Registrierungen, Admin-Aktionen, PHP Errors/Fatals (empfohlen)
#   warning  = PHP Warnings + alle Sicherheitswarnungen + Fehlschläge
#   critical = nur fatale Events (PHP Fatal, Rate Limit, 403, Löschungen)
DISCORD_LOG_LEVEL=debug
